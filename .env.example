# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/jrisita-ai

# AI APIs
HEYGEN_API_KEY=your_heygen_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_CLOUD_PROJECT_ID=your_google_project_id
GOOGLE_CLOUD_CREDENTIALS=path/to/service-account-key.json

# Storage
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=jrisita-videos
AWS_REGION=us-east-1

# Frontend URLs
FRONTEND_URL=http://localhost:3000
MOBILE_URL=exp://localhost:19000
